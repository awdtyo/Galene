# Copy to .env and fill in. Never commit .env.
# LLM provider switch. 'mock' works offline (default).
ORCA_LLM_PROVIDER=mock
# Used when provider=groq / openai / openai-compatible / anthropic / ollama
ORCA_LLM_MODEL=
ORCA_LLM_API_KEY=
ORCA_LLM_BASE_URL=
# Groq + GPT-OSS-120B example (uncomment and fill key in local .env only):
# ORCA_LLM_PROVIDER=groq
# ORCA_LLM_MODEL=openai/gpt-oss-120b
# ORCA_LLM_BASE_URL=https://api.groq.com/openai/v1
# ORCA_LLM_API_KEY=gsk_...
# App
ORCA_LOG_LEVEL=INFO
ORCA_DATA_CACHE_DIR=data/cache
ORCA_DATA_FIXTURES_DIR=data/fixtures
# Copernicus Data Space Ecosystem OAuth (local .env only, never commit):
# ORCA_COPERNICUS_CLIENT_ID=sh-...
# ORCA_COPERNICUS_CLIENT_SECRET=...
